[Desktop Entry]
Version=1.0
Type=Application
Name=Nitro Sense
Comment=Acer Nitro AN515-55 sensor monitor
Exec=/usr/local/bin/nitro-sense
Icon=cpu
Categories=System;Monitor;
StartupNotify=false
X-GNOME-Autostart-enabled=true
